<!DOCTYPE html>
<html lang="fr">
<head><style>
@font-face {
  font-family: "Optimistic";
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url("/fonts/OptimisticAI_VF_Optimized.woff2") format("woff2");
}
@font-face {
  font-family: "Optimistic Mono";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/fonts/OptimisticMono_W_TextRegular.woff2") format("woff2");
}
:where(html) {
  font-family: "Optimistic", system-ui, sans-serif;
}
:where(code, pre, kbd, samp) {
  font-family: "Optimistic Mono", ui-monospace, monospace;
}
</style>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Carnet discret + sport</title>
<style>
:root{--bg:#f6f7fb;--card:#fff;--acc:#6c5ce7;--ok:#00b894;--bad:#d63031;--text:#2d3436}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--text)}
header{padding:12px 16px;background:var(--card);position:sticky;top:0;z-index:10;box-shadow:0 2px 8px rgba(0,0,0,.06);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
h1{font-size:17px;margin:0}
.btn{border:0;border-radius:10px;padding:8px 12px;background:var(--acc);color:#fff;font-weight:600;cursor:pointer}
.btn-sm{padding:6px 10px;font-size:12px}
.btn-ghost{background:#eee;color:#333}
.btn-danger{background:var(--bad)}
.card{background:var(--card);margin:10px;border-radius:14px;padding:12px;box-shadow:0 2px 8px rgba(0,0,0,.05)}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:end}
input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid #ddd;font-size:14px;box-sizing:border-box}
label{font-size:12px;font-weight:600;margin:6px 0 2px;display:block}
.item{border:1px solid #e5e7eb;border-radius:12px;padding:10px;margin:8px 0;background:#fff}
.item-head{display:flex;justify-content:space-between;gap:8px;align-items:center;cursor:pointer;padding:4px}
.item-body{display:none;margin-top:10px;padding:12px;border-top:2px solid #6c5ce7;background:#f9fafb;border-radius:8px;font-size:13px;line-height:1.6}
.item.open .item-body{display:block}
img.thumb{width:85px;height:65px;object-fit:cover;border-radius:8px;border:2px solid #0ea5e9;cursor:pointer}
.badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;background:#dfe6e9}
canvas{width:100%!important;height:150px!important;background:#fff;border-radius:10px}
details summary{cursor:pointer;font-weight:700;padding:8px 0;font-size:15px}
#toast{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:#2d3436;color:#fff;padding:10px 14px;border-radius:20px;display:none;z-index:99;max-width:90%;text-align:center}
.form-box{border:1px dashed #ccc;padding:10px;border-radius:12px;margin-top:8px}
.preview-box{margin-top:8px;padding:8px;background:#f0fdf4;border:1px solid #22c55e;border-radius:10px;display:none}
.preview-box.has-photo{display:block}
#imgModal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.9);z-index:100;justify-content:center;align-items:center;flex-direction:column;padding:20px;box-sizing:border-box}
#imgModal img{max-width:95%;max-height:75%;border-radius:12px}
.discreet-banner{display:none;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:8px 10px;margin:10px;font-size:11px;color:#64748b}
.discreet-banner.show{display:flex;justify-content:space-between;align-items:center;gap:8px}
.tip{background:#fef3c7;border:1px solid #fde68a;border-radius:8px;padding:8px;margin-top:8px;font-size:11px}
</style>
</head>
<body>
<header><h1>📒 Carnet complet</h1><div class="row"><button class="btn btn-sm btn-ghost" onclick="exportData()">Exporter</button></div></header>
<div id="toast"></div>
<div id="imgModal" onclick="this.style.display='none'"><img id="modalImg"><div style="margin-top:12px"><button class="btn btn-sm" onclick="document.getElementById('imgModal').style.display='none'">Fermer</button></div></div>
<main style="max-width:720px;margin:auto;padding-bottom:90px">

<!-- BANDEAU DISCRET - ne s'affiche que si recettes vides -->
<div id="discreetFix" class="discreet-banner">
<span>⚠️ Recettes incomplètes détectées (que titres)</span>
<button class="btn btn-sm" style="background:#6c5ce7;font-size:11px" onclick="forceRecipes()">Restaurer 14 complètes</button>
</div>

<div class="card"><details open id="det-gly"><summary>🩸 Glycémie <span id="g-count" class="badge">0</span> <span id="alert-ind" class="badge" style="display:none;background:#00b894;color:#fff">⏰</span></summary>
<div id="alert-pending"></div><div id="alert-setup" style="display:none;background:#fff7e6;border:1px solid #ffe58f;border-radius:10px;padding:8px;margin:8px 0;font-size:12px">⏰ Rappel 2h ?<div class="row" style="margin-top:6px"><button class="btn btn-sm" style="background:#00b894" onclick="activateAlert(120)">Oui 2h</button><button class="btn btn-sm btn-ghost" onclick="document.getElementById('alert-setup').style.display='none'">Non</button></div></div>
<canvas id="gChart"></canvas>
<div class="form-box"><label>Valeur *</label><input id="gVal" type="number" inputmode="numeric"><div class="row"><div style="flex:1"><label>Moment</label><select id="gMoment" onchange="onMomentChange()"><option value="à jeun">À jeun</option><option value="avant repas">Avant repas</option><option value="après repas">2h après repas</option><option value="coucher">Coucher</option></select></div><div style="flex:1"><label>Date</label><input id="gDate" type="date"></div><div style="flex:1"><label>Heure</label><input id="gTime" type="time"></div></div><label>Photo lecteur</label><input id="gPhoto" type="file" accept="image/*"><div id="gPreview" class="preview-box"></div><div class="row" style="margin-top:6px"><button class="btn btn-sm btn-ghost" onclick="clearPhoto('g')">❌ Sans</button><button class="btn btn-sm" style="background:#0ea5e9" onclick="openPhoto('g')">🖼️ Voir</button><label style="font-weight:400;display:flex;align-items:center;gap:4px"><input type="checkbox" id="chkAlert" checked style="width:auto"> Alerte 2h</label></div><label>Note</label><input id="gNote"><div class="row" style="margin-top:8px"><button class="btn" onclick="saveGly(false)">Enregistrer</button><button class="btn btn-ghost" onclick="cancelEdit()">Annuler</button></div></div><div id="gList"></div></details></div>

<div class="card"><details open id="det-food"><summary>🍽️ Recettes détaillées <span id="f-count" class="badge">0</span></summary>
<div id="fList"></div>
<div style="margin-top:8px;text-align:center"><button class="btn btn-sm btn-ghost" onclick="forceRecipes()" style="font-size:11px;color:#64748b">♻️ Restaurer les 14 recettes complètes si besoin</button></div>
</details></div>

<div class="card"><details open id="det-tens"><summary>❤️ Tension <span id="t-count" class="badge">0</span></summary>
<div class="form-box" style="border-color:#0ea5e9;border-style:solid;background:#f0f9ff">
<div class="row"><div style="flex:1"><label>SYS/DIA Pouls *</label><input id="tVal" placeholder="120/80 72"></div><div style="flex:1"><label>Date</label><input id="tDate" type="date"></div><div style="flex:1"><label>Heure</label><input id="tTime" type="time"></div></div>
<label>📸 Photo tensiomètre - galerie OK (sans capture forcée)</label>
<input id="tPhoto" type="file" accept="image/*">
<div style="font-size:10px;color:#0369a1;margin:4px 0">iPhone te propose : Photothèque / Prendre photo / Parcourir → choisis Photothèque pour récupérer</div>
<div id="tPreview" class="preview-box"><div id="tPreviewInner">Aucune photo</div></div>
<div class="row" style="margin-top:8px"><button class="btn btn-sm btn-ghost" onclick="clearPhoto('t')">❌ Effacer</button><button class="btn btn-sm" style="background:#0ea5e9" onclick="openPhoto('t')">🖼️ Voir photo</button></div>
<label>Note</label><input id="tNote"><div class="row" style="margin-top:8px"><button class="btn" style="background:#0ea5e9" onclick="saveTension()">Enregistrer tension + photo</button><button class="btn btn-ghost" onclick="cancelEdit()">Annuler</button></div>
<div id="tStatus" style="font-size:11px;margin-top:6px;color:#059669"></div>
</div><div id="tList"></div></details></div>

<div class="card"><details id="det-meds"><summary>💊 Médicaments <span id="m-count" class="badge">0</span></summary><div class="form-box"><div class="row"><div style="flex:1"><label>Nom</label><input id="mVal"></div><div style="flex:1"><label>Date</label><input id="mDate" type="date"></div></div><label>Photo</label><input id="mPhoto" type="file" accept="image/*"><div id="mPreview" class="preview-box"></div><div class="row" style="margin-top:8px"><button class="btn" onclick="saveMeds()">Enregistrer</button></div></div><div id="mList"></div></details></div>

<div class="card"><details id="det-analyses"><summary>🧪 Analyses <span id="a-count" class="badge">0</span></summary><div class="form-box"><div class="row"><div style="flex:1"><label>Type</label><input id="aVal"></div><div style="flex:1"><label>Résultat</label><input id="aResult"></div><div style="flex:1"><label>Date</label><input id="aDate" type="date"></div></div><label>Photo</label><input id="aPhoto" type="file" accept="image/*"><div id="aPreview" class="preview-box"></div><div class="row" style="margin-top:8px"><button class="btn" onclick="saveAnalyses()">Enregistrer</button></div></div><div id="aList"></div></details></div>

<div class="card"><details id="det-sommeil"><summary>😴 Sommeil HUAWEI <span id="sl-count" class="badge">0</span></summary><div class="form-box"><div class="row"><div style="flex:1"><label>Date</label><input id="slDate" type="date"></div><div style="flex:1"><label>Total</label><input id="slTotal" placeholder="7h13"></div></div><div class="row"><div style="flex:1"><label>S1 début</label><input id="slS1D" type="time"></div><div style="flex:1"><label>fin</label><input id="slS1F" type="time"></div><div style="flex:1"><label>durée</label><input id="slS1Dur"></div></div><div class="row"><div style="flex:1"><label>Éveil</label><input id="slEveil"></div><div style="flex:1"><label>Para</label><input id="slPara"></div><div style="flex:1"><label>Lent</label><input id="slLent"></div><div style="flex:1"><label>Prof</label><input id="slProf"></div></div><div class="row"><div style="flex:1"><label>S2 début</label><input id="slS2D" type="time"></div><div style="flex:1"><label>fin</label><input id="slS2F" type="time"></div><div style="flex:1"><label>durée</label><input id="slS2Dur"></div></div><div class="row" style="margin-top:8px"><button class="btn" onclick="saveSommeil()">Enregistrer nuit</button></div></div><div id="slList"></div></details></div>

<!-- SPORT RESTAURÉ -->
<div class="card"><details open id="det-sport"><summary>🏃 Sport <span id="s-count" class="badge">0</span></summary>
<div class="form-box"><div class="row"><div style="flex:2"><label>Activité *</label><input id="sVal" placeholder="Marche 30min, vélo..."></div><div style="flex:1"><label>Date</label><input id="sDate" type="date"></div><div style="flex:1"><label>Durée</label><input id="sDur" placeholder="30min"></div></div><div class="row" style="margin-top:8px"><button class="btn" onclick="saveSport()">Enregistrer sport</button><button class="btn btn-ghost" onclick="cancelEdit()">Annuler</button></div></div><div id="sList"></div>
</details></div>

<div class="card"><details id="det-notes"><summary>📝 Notes <span id="n-count" class="badge">0</span></summary><div class="form-box"><div class="row"><input id="nVal" placeholder="Note..." style="flex:1"><button class="btn btn-sm" onclick="saveItem('notes','nVal')">OK</button></div></div><div id="nList"></div></details></div>

</main>
<script>
const KEY='carnet_v12_final';
const DEFAULT_RECIPES=[
{title:"Harira - Soupe Ramadan complète (6 pers)",type:"recette",ing:"• Tomates mûres 500g\n• Pois chiches 200g trempés 12h\n• Lentilles vertes 100g\n• Oignon 1 gros 150g\n• Céleri 1 branche + coriandre 1 bouquet + persil 1 bouquet\n• Viande boeuf 200g dés (facultatif)\n• Concentré tomate 2cs\n• Farine 1cs + eau 100ml (tedouira)\n• Épices: curcuma 1cc, gingembre 1cc, cannelle 1/2cc, poivre, sel\n• Huile olive 2cs + eau 1,5L",steps:"1. Mixer tomates.\n2. Marmite: huile + viande + oignon 5min.\n3. Ajouter tomates + concentré + pois chiches + lentilles + 1,5L eau + épices. Cuire 40min sous pression.\n4. Mélanger farine + 100ml eau froide, verser en filet en remuant.\n5. Herbes hachées 10min. Servir citron + dattes.\n\nConservation 3j frigo.",meta:"60min | 6 pers | IG moyen",tip:"💡 Diabète: 1 louche 200ml = ~20g glucides. Version allégée: 1cc farine seulement."},
{title:"Tajine poulet citron confit olives (4 pers)",type:"recette",ing:"• Poulet 1kg\n• Oignons 2 moyens 300g\n• Ail 3 gousses\n• Citrons confits 2\n• Olives vertes 100g dessalées\n• Coriandre + persil 2cs\n• Gingembre 1cc, curcuma 1cc, poivre, sel, safran pincée\n• Huile olive 3cs + eau 200ml",steps:"1. Tajine: huile + oignons + ail 5min.\n2. Ajouter poulet + épices + herbes, dorer 5min.\n3. Eau 200ml, couvrir feu doux 30min.\n4. Ajouter citrons + olives, 30min jusqu'à fondant.\n5. Servir avec 3cs semoule complète ou 1/4 pain.",meta:"1h15 | 4 pers | IG bas",tip:"💡 Poulet + olives = ralentit pic glycémique."},
{title:"Couscous 7 légumes vendredi (6 pers)",type:"recette",ing:"• Semoule 500g\n• Carottes 3, courgettes 2, navets 2, chou 1/4, courge 300g, tomates 2, pois chiches 200g\n• Oignon 1 + concentré 1cs\n• Ras el hanout 1cs, curcuma, poivre, sel\n• Huile 4cs + beurre 30g + eau 2L",steps:"1. Sauce: oignon + tomates + épices + huile 5min. Légumes durs + eau 2L 20min. Légumes tendres + pois chiches 15min.\n2. Semoule: huile + eau + vapeur 15min x3 (3 vapeurs).\n3. Beurre à la fin.\n4. 4-5 cs semoule + beaucoup légumes.",meta:"1h30 | 6 pers",tip:"💡 4-5 cs max = 30g glucides."},
{title:"Chorba frik blé vert (4 pers)",type:"recette",ing:"• Viande 300g dés\n• Frik 100g lavé\n• Pois chiches 100g\n• Tomates 400g\n• Oignon 1\n• Coriandre + menthe\n• Carvi 1cc, paprika, cannelle pincée, sel, poivre\n• Huile 2cs + eau 1,5L",steps:"1. Huile + viande + oignon 5min.\n2. Tomates + pois chiches + frik + épices + eau.\n3. Cuire 45min sous pression.\n4. Herbes fin.\n\nFrik = fibres, IG bas.",meta:"1h | IG bas",tip:"💡 Frik meilleur que vermicelles."},
{title:"Salade marocaine + Taktouka + Zaalouk",type:"recette",ing:"Taktouka: poivrons 2 grillés + tomates 3 + ail 2 + cumin + paprika + huile\nZaalouk: aubergine 1 + tomates 3 + ail + cumin + paprika + coriandre\nCrue: tomates 4 + concombre 2 + oignon 1 + poivron + persil + huile 3cs + citron",steps:"1. Griller poivrons/aubergine four 20min, peler.\n2. Ail + tomates + épices 10min, ajouter poivrons/aubergine 15min.\n3. Crue: dés + vinaigrette.\n\nÀ volonté.",meta:"30min | IG très bas",tip:"💡 À volonté avant plat."},
{title:"Briouates amandes miel - four (20 pcs)",type:"recette",ing:"• Brick 10 coupées en 2\n• Amandes 250g grillées mixées\n• Sucre 50g + cannelle 1cc + fleur d'oranger 1cs + beurre 30g\n• Miel 150g + sésame\n• Huile friture ou four",steps:"1. Mixer amandes + sucre + cannelle + beurre + fleur d'oranger.\n2. Bandes 8cm, 1cc farce, triangle.\n3. Four 180°C 12min (conseillé) ou friture 2min.\n4. Miel 10sec, sésame.\n5. 1 = 15g glucides.",meta:"45min | IG haut",tip:"💡 1 seule après repas."},
{title:"Loubia haricots blancs (4 pers) - IG bas",type:"recette",ing:"• Haricots blancs 400g trempés 12h\n• Tomates 400g + concentré 1cs\n• Oignon 1 + ail 3\n• Cumin 1cc + paprika + sel + poivre + laurier\n• Huile 2cs + persil",steps:"1. Haricots 30min eau non salée.\n2. Sauce: oignon + ail + tomates + épices 10min.\n3. Ajouter haricots + eau cuisson, 20min.\n4. Persil.\n\nProtéine végétale + fibres.",meta:"50min | IG bas",tip:"💡 1 assiette = 30g glucides lents."},
{title:"Rfissa poulet lentilles fenugrec (4 pers)",type:"recette",ing:"• Msemen 500g déchiré\n• Poulet 1kg\n• Lentilles 200g + fenugrec 1cs trempé 1h rincé\n• Oignons 500g\n• Ras el hanout 1cs + curcuma + gingembre + sel + poivre + safran\n• Huile 3cs + smen 1cc",steps:"1. Marmite: poulet + oignons + lentilles + fenugrec + épices + eau 1L 1h.\n2. Déchirer msemen plat.\n3. Arroser sauce + oignons + lentilles.\n4. Poulet centre.",meta:"1h20 | IG moyen",tip:"💡 Fenugrec aide glycémie."},
{title:"Tajine kefta oeufs rapide 25min (4 pers)",type:"recette",ing:"• Kefta boeuf 500g\n• Tomates 500g\n• Oignon 1 + ail 2 + coriandre + persil\n• Oeufs 4\n• Cumin 1cc, paprika, sel, poivre\n• Huile 2cs",steps:"1. Sauce: oignon + ail + tomates + épices 15min.\n2. Boulettes 20g.\n3. Déposer dans sauce 10min.\n4. 4 puits, 1 oeuf chaque, couvrir 5min mollets.\n5. Coriandre.\n\n1/4 pain complet.",meta:"25min | IG bas",tip:"💡 Protéines + peu glucides."},
{title:"Seffa vermicelles sucrés amandes (6 pers)",type:"recette",ing:"• Vermicelles seffa 500g\n• Beurre 100g + sel 1cc\n• Sucre glace 60g + cannelle 1cs\n• Amandes 100g + raisins 50g\n• Huile 2cs + eau",steps:"1. Huiler + sel, vapeur 20min x3 (arroser eau entre).\n2. Beurre final 5min.\n3. Dôme + sucre glace + cannelle + amandes.\n\n3 cs max = 20g glucides.",meta:"1h | IG haut",tip:"💡 Cannelle aide."},
{title:"Pastilla poulet amandes (6 pers) - fête",type:"recette",ing:"• Poulet 1kg + oignons 500g + persil + coriandre\n• Feuilles pastilla 10\n• Oeufs 4\n• Amandes 200g + sucre 50g + cannelle 2cc\n• Beurre 100g + huile\n• Gingembre, curcuma, cannelle, sel, poivre, safran",steps:"1. Poulet + oignons + herbes + épices + eau 500ml 45min, effilocher.\n2. Compote oignons + oeufs brouillés.\n3. Amandes grillées + sucre + cannelle mix.\n4. Montage moule: 4 feuilles dépassent + 2 centre, couches oignons/oeufs, poulet, amandes, rabattre, 2 feuilles dessus beurrées.\n5. Four 180°C 20-25min.\n6. Sucre glace + cannelle damier.\n\n1/6 = 35g glucides.",meta:"1h30 | IG haut",tip:"💡 1 part max + salade."},
{title:"Tanjia Marrakech (4 pers) 4h",type:"recette",ing:"• Boeuf jarret 1kg\n• Ail 5 gousses\n• Cumin 2cc + sel + poivre\n• Citron confit 1\n• Smen 1cs + huile 2cs + safran + eau 100ml",steps:"1. Jarre: viande + ail + épices + citron + smen + huile + eau, mélanger.\n2. Papier cuisson + ficelle, petit trou.\n3. Four 150°C 4h ou ferrane matin→midi.\n4. Confite.\n\n0 glucide, avec salades.",meta:"4h | IG 0",tip:"💡 0 glucide."},
{title:"Msemen (10 pcs)",type:"recette",ing:"• Farine 500g + semoule fine 250g\n• Sel 1cc + levure 5g + sucre 1cc\n• Eau 400ml\n• Huile 100ml + beurre 50g + semoule fine",steps:"1. Mélanger + eau, pétrir 10min, 10 boules huilées 15min repos.\n2. Étaler très fin, huile/beurre + semoule, plier en 3 puis 3 = carré.\n3. Aplatir, poêle chaude 3-4min chaque côté.\n\n1 = 30g glucides.",meta:"1h | IG haut",tip:"💡 1/2 farine complète."},
{title:"Baghrir 1000 trous (15 pcs)",type:"recette",ing:"• Semoule fine 250g + farine 75g\n• Levure boulangère 10g + chimique 1 sachet\n• Sucre 1cc + sel pincée + eau 500ml\n• Beurre + miel service",steps:"1. Blender: tout + eau 500ml 2min mousseux.\n2. Reposer 10min bulles.\n3. Poêle antiadhésive SANS huile, 1 louche centre, ne pas étaler, trous 30sec, cuire 1 seul côté.\n4. Torchon, pas empiler chaud.\n5. Beurre + miel.\n\nPas trous: trop épaisse +50ml eau. Déchire: trop liquide +1cs semoule.",meta:"30min | IG moyen-haut",tip:"💡 1 = 15g glucides, 2 max + oeuf."}
];
let stored=JSON.parse(localStorage.getItem(KEY)||'null');
let data=stored?stored:{glucose:[],foods:JSON.parse(JSON.stringify(DEFAULT_RECIPES)),tension:[],meds:[],analyses:[],sommeil:[{date:"2026-09-20",total:"7h13",s1d:"01:22",s1f:"04:22",s1dur:"3h49",eveil:"11 min",para:"41 min",lent:"2h44",prof:"24 min",s2d:"06:00",s2f:"09:24",s2dur:"3h24",qual:"Bonne",obs:"Sensation reposée",source:"HUAWEI",ts:Date.now()}],sport:[],notes:[]};
if(!data.tension)data.tension=[];if(!data.meds)data.meds=[];if(!data.analyses)data.analyses=[];if(!data.sommeil)data.sommeil=[];if(!data.sport)data.sport=[];if(!data.notes)data.notes=[];
let alerts=JSON.parse(localStorage.getItem('carnet_alerts')||'[]');
let edit={type:null,index:null};
let photos={g:null,t:null,m:null,a:null,f:null};

function save(){localStorage.setItem(KEY,JSON.stringify(data));render();}
function saveAlerts(){localStorage.setItem('carnet_alerts',JSON.stringify(alerts));renderAlerts();}
function toast(t){const el=document.getElementById('toast');el.textContent=t;el.style.display='block';setTimeout(()=>el.style.display='none',4000);}
function todayStr(){return new Date().toISOString().slice(0,10);}function nowStr(){return new Date().toTimeString().slice(0,5);}
['gDate','tDate','mDate','aDate','slDate','sDate'].forEach(id=>{const e=document.getElementById(id);if(e&&!e.value)e.value=todayStr();});
['gTime','tTime'].forEach(id=>{const e=document.getElementById(id);if(e&&!e.value)e.value=nowStr();});

function compress(file,cb){
 const r=new FileReader();
 r.onload=e=>{
  const img=new Image();
  img.onload=()=>{
   let w=img.width,h=img.height;const max=700;
   if(w>max||h>max){const s=Math.min(max/w,max/h);w*=s;h*=s;}
   const c=document.createElement('canvas');c.width=w;c.height=h;
   c.getContext('2d').drawImage(img,0,0,w,h);
   cb(c.toDataURL('image/jpeg',0.55));
  };
  img.onerror=()=>cb(e.target.result);
  img.src=e.target.result;
 };
 r.readAsDataURL(file);
}
function setupPhoto(inputId,key,previewId){
 const input=document.getElementById(inputId);
 if(!input)return;
 input.addEventListener('change',e=>{
  const f=e.target.files[0];if(!f)return;
  const box=document.getElementById(previewId);
  const quick=new FileReader();
  quick.onload=ev=>{
   photos[key]=ev.target.result;
   if(box){box.classList.add('has-photo');box.innerHTML=`<img src="${ev.target.result}" style="width:110px;height:75px;object-fit:cover;border-radius:8px"> <small>Compression...</small>`;}
  };
  quick.readAsDataURL(f);
  compress(f,url=>{
   photos[key]=url;
   if(box){box.classList.add('has-photo');box.innerHTML=`<div style="display:flex;gap:8px;align-items:center"><img src="${url}" style="width:110px;height:75px;object-fit:cover;border-radius:8px;cursor:pointer" onclick="showImg('${url.replace(/'/g,'')}')"><div><b style="color:#059669">✓ Photo prête ${Math.round(url.length/1024)}Ko</b><br><small>Tap pour voir</small></div></div>`;}
   toast('Photo '+key.toUpperCase()+' prête');
  });
 });
}
setupPhoto('gPhoto','g','gPreview');
setupPhoto('tPhoto','t','tPreview');
setupPhoto('mPhoto','m','mPreview');
setupPhoto('aPhoto','a','aPreview');

function clearPhoto(k){photos[k]=null;const b=document.getElementById(k+'Preview');if(b){b.classList.remove('has-photo');b.innerHTML=k==='t'?'<div id="tPreviewInner">Aucune photo</div>':'';}const inp=document.getElementById(k+'Photo');if(inp)inp.value='';}
function showImg(src){if(!src||src.length<100){toast('Pas de photo');return;}document.getElementById('modalImg').src=src;document.getElementById('imgModal').style.display='flex';}
function openPhoto(k){
 if(photos[k]&&photos[k].length>100){showImg(photos[k]);return;}
 let last=null;
 if(k==='t') last=[...data.tension].reverse().find(x=>x.photo);
 if(k==='g') last=[...data.glucose].reverse().find(x=>x.photo);
 if(last&&last.photo)showImg(last.photo);else toast('Aucune photo - choisis Photothèque d\'abord');
}
function forceRecipes(){
 if(confirm('Écraser les 14 recettes par les 14 recettes COMPLÈTES détaillées ? Tes glycémies/tensions/médicaments restent.')){
  data.foods=JSON.parse(JSON.stringify(DEFAULT_RECIPES));
  save();
  document.getElementById('discreetFix').classList.remove('show');
  toast('✅ 14 recettes détaillées installées');
 }
}
function onMomentChange(){const chk=document.getElementById('chkAlert');if(chk)chk.checked=(document.getElementById('gMoment').value==='avant repas');}
function saveGly(fromAuto){let v=parseInt(document.getElementById('gVal').value);if(!v){toast('Entre valeur');return false;}const o={v:v,moment:document.getElementById('gMoment').value,date:document.getElementById('gDate').value||todayStr(),time:document.getElementById('gTime').value||nowStr(),note:document.getElementById('gNote').value,photo:photos.g,ts:Date.now()};if(edit.type==='glucose'){data.glucose[edit.index]=o;edit={type:null,index:null};}else data.glucose.push(o);document.getElementById('gVal').value='';document.getElementById('gNote').value='';clearPhoto('g');save();if(!fromAuto){if(document.getElementById('chkAlert').checked && (o.moment==='avant repas'||o.moment==='à jeun'))document.getElementById('alert-setup').style.display='block';else toast(`Glycémie ${v} enregistrée`);}else{toast(`✅ Glycémie ${v} auto`);document.getElementById('alert-setup').style.display='block';}return true;}
function saveTension(){const v=document.getElementById('tVal').value.trim();if(!v){toast('Entre tension');return;}const o={v:v,date:document.getElementById('tDate').value||todayStr(),time:document.getElementById('tTime').value||nowStr(),note:document.getElementById('tNote').value,photo:photos.t,ts:Date.now()};if(edit.type==='tension'){data.tension[edit.index]=o;edit={type:null,index:null};}else data.tension.push(o);document.getElementById('tVal').value='';document.getElementById('tNote').value='';clearPhoto('t');save();toast(`✅ Tension ${v} ${o.photo?'avec photo':''}`);document.getElementById('tStatus').textContent='Enregistrée: '+v+' '+(o.photo?'avec photo '+Math.round(o.photo.length/1024)+'Ko':'');}
function saveMeds(){const v=document.getElementById('mVal').value.trim();if(!v)return;const o={v:v,date:document.getElementById('mDate').value||todayStr(),photo:photos.m,ts:Date.now()};if(edit.type==='meds'){data.meds[edit.index]=o;edit={type:null,index:null};}else data.meds.push(o);document.getElementById('mVal').value='';clearPhoto('m');save();}
function saveAnalyses(){const v=document.getElementById('aVal').value.trim();if(!v)return;const o={v:v,result:document.getElementById('aResult').value,date:document.getElementById('aDate').value||todayStr(),photo:photos.a,ts:Date.now()};if(edit.type==='analyses'){data.analyses[edit.index]=o;edit={type:null,index:null};}else data.analyses.push(o);document.getElementById('aVal').value='';document.getElementById('aResult').value='';clearPhoto('a');save();}
function saveSommeil(){const o={date:document.getElementById('slDate').value||todayStr(),total:document.getElementById('slTotal').value,s1d:document.getElementById('slS1D').value,s1f:document.getElementById('slS1F').value,s1dur:document.getElementById('slS1Dur').value,eveil:document.getElementById('slEveil').value,para:document.getElementById('slPara').value,lent:document.getElementById('slLent').value,prof:document.getElementById('slProf').value,s2d:document.getElementById('slS2D').value,s2f:document.getElementById('slS2F').value,s2dur:document.getElementById('slS2Dur').value,qual:'Bonne',obs:'',ts:Date.now()};if(edit.type==='sommeil'){data.sommeil[edit.index]=o;edit={type:null,index:null};}else data.sommeil.push(o);save();}
function saveSport(){const v=document.getElementById('sVal').value.trim();if(!v){toast('Activité requise');return;}const o={v:v+' '+(document.getElementById('sDur').value||''),date:document.getElementById('sDate').value||todayStr(),ts:Date.now()};if(edit.type==='sport'){data.sport[edit.index]=o;edit={type:null,index:null};}else data.sport.push(o);document.getElementById('sVal').value='';document.getElementById('sDur').value='';save();toast('Sport enregistré');}
function saveItem(cat,id){const val=document.getElementById(id).value.trim();if(!val)return;const o={v:val,date:todayStr(),ts:Date.now()};if(edit.type===cat){data[cat][edit.index]=o;edit={type:null,index:null};}else data[cat].push(o);document.getElementById(id).value='';save();}
function toggleRecipe(i){const el=document.getElementById('food-'+i);if(el)el.classList.toggle('open');}
function editItem(cat,i){edit={type:cat,index:i};const o=data[cat][i];if(cat==='tension'){document.getElementById('tVal').value=o.v;document.getElementById('tDate').value=o.date;document.getElementById('tTime').value=o.time;document.getElementById('tNote').value=o.note||'';photos.t=o.photo;if(photos.t){const b=document.getElementById('tPreview');b.classList.add('has-photo');b.innerHTML=`<img src="${photos.t}" style="width:110px;height:75px;object-fit:cover;border-radius:8px"> Photo existante`;}document.getElementById('det-tens').open=true;}else if(cat==='sport'){document.getElementById('sVal').value=o.v;document.getElementById('sDate').value=o.date;document.getElementById('det-sport').open=true;}else if(cat==='glucose'){document.getElementById('gVal').value=o.v;document.getElementById('det-gly').open=true;}}
function delItem(cat,i){if(!confirm('Supprimer ?'))return;data[cat].splice(i,1);edit={type:null,index:null};save();}
function cancelEdit(){edit={type:null,index:null};}
function activateAlert(mins){const due=Date.now()+mins*60000;const id='al_'+Date.now();alerts.push({id:id,due:due,label:`Reprendre glycémie`,mins:mins});saveAlerts();document.getElementById('alert-setup').style.display='none';toast(`⏰ Alerte ${mins}min`);setTimeout(()=>triggerAlert(id),mins*60000);}
function triggerAlert(id){const a=alerts.find(x=>x.id===id);if(!a)return;alert('⏰ Reprends ta glycémie !');alerts=alerts.filter(x=>x.id!==id);saveAlerts();}
function renderAlerts(){const c=document.getElementById('alert-pending');if(!c)return;if(alerts.length===0){c.innerHTML='';document.getElementById('alert-ind').style.display='none';return;}document.getElementById('alert-ind').style.display='inline-block';c.innerHTML=alerts.map(a=>{const rem=Math.max(0,Math.ceil((a.due-Date.now())/60000));return `<div style="background:#e6fffa;border:1px solid #81e6d5;border-radius:10px;padding:8px;margin:6px 0;font-size:12px;display:flex;justify-content:space-between"><span>⏰ ${a.label} dans ${rem}min</span><button class="btn btn-sm btn-ghost" onclick="cancelAlert('${a.id}')">Annuler</button></div>`}).join('');}
function cancelAlert(id){alerts=alerts.filter(x=>x.id!==id);saveAlerts();}
function exportData(){const blob=new Blob([JSON.stringify(data)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='carnet.json';a.click();}
function render(){
 const firstFood=data.foods[0];
 const isIncomplete=!firstFood||!firstFood.ing||firstFood.ing.length<20;
 document.getElementById('discreetFix').classList.toggle('show',isIncomplete);
 document.getElementById('g-count').textContent=data.glucose.length;
 document.getElementById('f-count').textContent=data.foods.length;
 document.getElementById('t-count').textContent=data.tension.length;
 document.getElementById('m-count').textContent=data.meds.length;
 document.getElementById('a-count').textContent=data.analyses.length;
 document.getElementById('sl-count').textContent=(data.sommeil||[]).length;
 document.getElementById('s-count').textContent=(data.sport||[]).length;
 document.getElementById('n-count').textContent=(data.notes||[]).length;
 document.getElementById('gList').innerHTML=[...data.glucose].sort((a,b)=>b.ts-a.ts).map(o=>{const orig=data.glucose.findIndex(x=>x.ts===o.ts);return `<div class="item"><div style="display:flex;gap:8px;align-items:center">${o.photo?`<img src="${o.photo}" class="thumb" onclick="showImg('${o.photo}')">`:''}<div><b>${o.v} mg/dL</b> <span class="badge">${o.moment}</span><br><small>${o.date}</small></div></div><div class="row"><button class="btn btn-sm btn-ghost" onclick="editItem('glucose',${orig})">Modif</button><button class="btn btn-sm btn-danger" onclick="delItem('glucose',${orig})">Suppr</button></div></div>`}).join('')||'<small>Aucune</small>';
 document.getElementById('fList').innerHTML=data.foods.map((o,i)=>`
  <div class="item" id="food-${i}" style="${o.ing&&o.ing.length>50?'border-left:4px solid #22c55e':''}">
    <div class="item-head" onclick="toggleRecipe(${i})">
      <div style="flex:1"><b>${o.title}</b> <span class="badge">${o.type}</span><div style="font-size:11px;color:#6b7280">${o.meta||''}</div><small style="color:${o.ing&&o.ing.length>50?'#059669':'#ef4444'}">${o.ing&&o.ing.length>50?'👆 tap pour voir détails complets':'⚠️ titre seul - clique Restaurer en haut'}</small></div>
      <span>▼</span>
    </div>
    <div class="item-body">
      <div style="white-space:pre-wrap;background:#fff;padding:10px;border-radius:8px;margin:6px 0;border:1px solid #e5e7eb"><b>📋 Ingrédients:</b><br>${o.ing||'Vide'}</div>
      <div style="white-space:pre-wrap;background:#f0fdf4;padding:10px;border-radius:8px;margin:6px 0;border:1px solid #bbf7d0"><b>👩‍🍳 Étapes:</b><br>${o.steps||'—'}</div>
      ${o.tip?`<div class="tip">${o.tip}</div>`:''}
      <div class="row" style="margin-top:8px"><button class="btn btn-sm btn-ghost" onclick="toggleRecipe(${i})">Fermer</button><button class="btn btn-sm btn-danger" onclick="delItem('foods',${i})">Suppr</button></div>
    </div>
  </div>`).join('')||'<small>Aucune</small>';
 document.getElementById('tList').innerHTML=data.tension.map((o,i)=>`<div class="item" style="border-left:4px solid ${o.photo?'#0ea5e9':'#f87171'}"><div style="display:flex;gap:12px;align-items:center">${o.photo?`<img src="${o.photo}" class="thumb" onclick="showImg('${o.photo}')">`:`<div style="width:85px;height:65px;background:#fee2e2;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#ef4444;font-size:11px">❌ Pas photo</div>`}<div style="flex:1"><b style="font-size:18px">${o.v}</b><br><small>${o.date} ${o.time||''}</small><br><small>${o.note||''}</small><br>${o.photo?`<small style="color:#059669">✅ Photo ${Math.round(o.photo.length/1024)}Ko</small>`:`<small style="color:#ef4444">⚠️ Sans photo</small>`}</div></div><div class="row" style="margin-top:8px"><button class="btn btn-sm btn-ghost" onclick="editItem('tension',${i})">Modif</button><button class="btn btn-sm" style="background:#0ea5e9" onclick="showImg('${(o.photo||'').replace(/'/g,'')}')">🖼️ Voir / récupérer</button><button class="btn btn-sm btn-danger" onclick="delItem('tension',${i})">Suppr</button></div></div>`).join('')||'<small>Aucune tension - choisis Photothèque</small>';
 document.getElementById('mList').innerHTML=data.meds.map((o,i)=>`<div class="item"><div style="display:flex;gap:10px">${o.photo?`<img src="${o.photo}" class="thumb" onclick="showImg('${o.photo}')">`:''}<div><b>${o.v}</b><br><small>${o.date}</small></div></div><div class="row"><button class="btn btn-sm" style="background:#0ea5e9" onclick="showImg('${(o.photo||'').replace(/'/g,'')}')">🖼️ Photo</button><button class="btn btn-sm btn-danger" onclick="delItem('meds',${i})">Suppr</button></div></div>`).join('')||'<small>Aucun</small>';
 document.getElementById('aList').innerHTML=data.analyses.map((o,i)=>`<div class="item"><div style="display:flex;gap:10px">${o.photo?`<img src="${o.photo}" class="thumb" onclick="showImg('${o.photo}')">`:''}<div><b>${o.v} ${o.result||''}</b><br><small>${o.date}</small></div></div><div class="row"><button class="btn btn-sm" style="background:#0ea5e9" onclick="showImg('${(o.photo||'').replace(/'/g,'')}')">🖼️ Photo</button><button class="btn btn-sm btn-danger" onclick="delItem('analyses',${i})">Suppr</button></div></div>`).join('')||'<small>Aucune</small>';
 document.getElementById('slList').innerHTML=(data.sommeil||[]).map(o=>`<div class="item"><b>${o.date} - ${o.total}</b><br><small>S1 ${o.s1d}→${o.s1f} ${o.s1dur} | Éveil ${o.eveil} Para ${o.para} Lent ${o.lent} Prof ${o.prof}</small><br><small>S2 ${o.s2d}→${o.s2f} ${o.s2dur}</small></div>`).join('')||'<small>Aucune nuit</small>';
 document.getElementById('sList').innerHTML=(data.sport||[]).sort((a,b)=>b.ts-a.ts).map((o,i)=>`<div class="item"><div><b>🏃 ${o.v}</b><br><small>${o.date}</small></div><div class="row"><button class="btn btn-sm btn-ghost" onclick="editItem('sport',${i})">Modif</button><button class="btn btn-sm btn-danger" onclick="delItem('sport',${i})">Suppr</button></div></div>`).join('')||'<small>Aucun sport - ajoute marche, vélo...</small>';
 document.getElementById('nList').innerHTML=(data.notes||[]).map((o,i)=>`<div class="item"><div><b>${o.v}</b><br><small>${o.date}</small></div><div class="row"><button class="btn btn-sm btn-danger" onclick="delItem('notes',${i})">Suppr</button></div></div>`).join('')||'<small>Aucune note</small>';
 drawChart();renderAlerts();
}
function drawChart(){const c=document.getElementById('gChart');if(!c)return;const ctx=c.getContext('2d');const W=c.width=c.clientWidth*2;const H=c.height=320;ctx.clearRect(0,0,W,H);const vals=[...data.glucose].sort((a,b)=>a.ts-b.ts).slice(-20);if(vals.length<2){ctx.fillStyle='#999';ctx.font='18px sans-serif';ctx.fillText('Ajoute 2 glycémies',20,160);return;}const min=Math.min(...vals.map(o=>o.v),70)-10,max=Math.max(...vals.map(o=>o.v),180)+10;ctx.strokeStyle='#eee';for(let y=0;y<=4;y++){const yy=20+y*(H-40)/4;ctx.beginPath();ctx.moveTo(60,yy);ctx.lineTo(W-20,yy);ctx.stroke();}ctx.strokeStyle='#6c5ce7';ctx.lineWidth=4;ctx.beginPath();vals.forEach((o,i)=>{const x=60+i*(W-80)/(vals.length-1||1);const y=20+(1-(o.v-min)/(max-min||1))*(H-40);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);});ctx.stroke();}
function handleQuery(){const p=new URLSearchParams(location.search);const gv=p.get('glycemie')||p.get('value');if(gv){const v=parseInt(gv.replace(/\D/g,''));if(v){document.getElementById('gVal').value=v;document.getElementById('det-gly').open=true;setTimeout(()=>{saveGly(true);history.replaceState({},'',location.pathname);},800);}}}
window.addEventListener('load',()=>{render();handleQuery();});
</script>
<script>(function(){var loc=location.href.replace(/#.*$/,"");var ATTR_NAMES=["data-product-id","data-productid","data-product_id","product-id","productid","product_id","data-source-entity-id","source-entity-id","source_entity_id","data-product","data-metadata","data-meta"];var DATASET_KEYS=["productId","productid","product_id","sourceEntityId","sourceentityid","source_entity_id","product","metadata","meta"];function readProductId(value){if(typeof value!=="string"||value.length===0)return null;if(/^[0-9]{6,}$/.test(value))return value;var match=value.match(/(?:product(?:_|-)?id|source(?:_|-)?entity(?:_|-)?id)["'=:\s]+([0-9]{6,})/i);return match?match[1]:null}function extractProductId(start){for(var node=start;node&&node!==document.body;node=node.parentElement){for(var i=0;i<ATTR_NAMES.length;i++){var attrValue=node.getAttribute&&node.getAttribute(ATTR_NAMES[i]);var attrProductId=readProductId(attrValue);if(attrProductId)return attrProductId}var dataset=node.dataset||null;if(dataset){for(var j=0;j<DATASET_KEYS.length;j++){var dataValue=dataset[DATASET_KEYS[j]];var dataProductId=readProductId(dataValue);if(dataProductId)return dataProductId}}}return null}function isInlineMediaSlotElement(node){return !!(node&&node.getAttribute&&node.getAttribute("data-clippy-inline-media-slot")!==null)}function findInlineMediaSlot(start){for(var node=start;node&&node!==document.body;node=node.parentElement){if(isInlineMediaSlotElement(node))return node}return null}function readInlineMediaUrl(node){if(!node)return null;return node.getAttribute&&((node.getAttribute("data-clippy-inline-media-url")||node.getAttribute("data-url")||node.getAttribute("data_url")))||node.href||null}function stripHash(url){return String(url).replace(/#.*$/,"")}function urlsMatch(a,b){if(!a||!b)return false;try{return stripHash(new URL(a,loc).href)===stripHash(new URL(b,loc).href)}catch(_){return stripHash(a)===stripHash(b)}}function isFirstPartyReelUrl(value){try{var url=new URL(value,loc);if(url.protocol!=="https:")return false;var host=url.hostname.toLowerCase();var supported=host==="instagram.com"||host.endsWith(".instagram.com")||host==="facebook.com"||host.endsWith(".facebook.com");return supported&&/\/reels?\//i.test(url.pathname)}catch(_){return false}}function isInlineMediaUrlClick(node,href){var slot=findInlineMediaSlot(node);if(!slot)return false;var slotUrl=readInlineMediaUrl(slot);if(slotUrl)return urlsMatch(href,slotUrl);return isFirstPartyReelUrl(href)}function findDataHref(start){for(var node=start;node&&node!==document.body;node=node.parentElement){if(node.getAttribute){var href=node.getAttribute("data-href")||node.getAttribute("data-url");if(href)return{href:href,node:node}}}return null}var nativeOpen=window.open;window.open=function(url){if(parent!==window&&typeof url==="string"&&/^https?:\/\//.test(url)){parent.postMessage({type:"ecto:usercontent-link-click",href:url},"*");return null}return nativeOpen?nativeOpen.apply(window,arguments):null};document.addEventListener("click",function(e){var target=e.target instanceof Element?e.target:null;if(!target)return;if(parent===window)return;var a=target.closest?target.closest("a[href]"):null;if(a&&a.href&&/^https?:\/\//.test(a.href)&&a.href.replace(/#.*$/,"")!==loc){if(isInlineMediaUrlClick(a,a.href))return;var productId=extractProductId(target)||extractProductId(a);if(productId){e.preventDefault();parent.postMessage({type:"ecto-artifact-link-click",productId:productId},"*");return}e.preventDefault();parent.postMessage({type:"ecto:usercontent-link-click",href:a.href},"*");return}var dataHref=findDataHref(target);if(dataHref&&/^https?:\/\//.test(dataHref.href)&&dataHref.href.replace(/#.*$/,"")!==loc){if(isInlineMediaUrlClick(dataHref.node,dataHref.href))return;e.preventDefault();parent.postMessage({type:"ecto:usercontent-link-click",href:dataHref.href},"*")}},true)})();</script><script>(function(){var FOCUS_TYPE="ecto:artifact-focus-request";var CLOSE_TYPE="ecto:artifact-close-request";function focusArtifactDocument(){var body=document.body;if(!body)return;try{window.focus();}catch(e){}if(!body.hasAttribute("tabindex"))body.setAttribute("tabindex","-1");try{body.focus({preventScroll:true});}catch(e){try{body.focus();}catch(e2){}}}window.addEventListener("message",function(event){if(event.source!==window.parent)return;var data=event.data;if(!data||typeof data!=="object"||data.type!==FOCUS_TYPE)return;if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",focusArtifactDocument,{once:true});return;}focusArtifactDocument();});window.addEventListener("keydown",function(event){if(event.key!=="Escape")return;window.setTimeout(function(){if(event.defaultPrevented)return;window.parent.postMessage({type:CLOSE_TYPE},"*");},0);});})();</script></body>
</html>
